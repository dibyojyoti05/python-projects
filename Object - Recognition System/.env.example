# Enterprise AI Vision Platform Environment Configuration Template

# Database (PostgreSQL)
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=vision_platform

# Security / Authentication
SECRET_KEY=replace_with_a_secure_random_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Backend & CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
PROJECT_NAME="Enterprise AI Vision Platform"

# Redis Cache & Broker
REDIS_URL=redis://localhost:6379/0

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional AI / Cloud API Keys (Add if you want to integrate external Vision/LLM APIs)
AI_SERVICE_API_KEY=your_external_api_key_here
WEBHOOK_ALERT_URL=https://hooks.slack.com/services/...
