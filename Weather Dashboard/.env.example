# Weather Intelligence Platform Environment Configuration

# PostgreSQL Database (e.g. 127.0.0.1:5433)
DATABASE_URL=postgresql+asyncpg://postgres:root@127.0.0.1:5433/weather_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=weather_db

# Google Gemini API Key for Weather AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
