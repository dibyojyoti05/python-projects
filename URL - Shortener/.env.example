# ==========================================
# ENTERPRISE LINK MANAGEMENT - CONFIGURATION
# ==========================================

# 1. Security & Authentication
# ------------------------------------------
# Generate a secure key (e.g., openssl rand -hex 32)
SECRET_KEY=yoursecretkey_changethisinproduction
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Database (PostgreSQL)
# ------------------------------------------
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_links
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:5432/${POSTGRES_DB}

# 3. Redis & Caching
# ------------------------------------------
REDIS_URL=redis://redis:6379

# 4. Frontend configuration
# ------------------------------------------
# The base URL the frontend uses to hit the backend API (used during build and client runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# WebSocket endpoint for real-time notifications
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/notifications/ws

# 5. External Providers (Future)
# ------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# SENDGRID_API_KEY=SG...
