# Application Environment (development, production, testing)
APP_ENV=development
DEBUG=true

# Database URL (SQLite default, PostgreSQL supported)
# DATABASE_URL=sqlite:///./meeting_notes.db
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5433/ai_meeting_notes

# AI Provider Configuration (gemini, mock)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Transcription Provider Configuration (whisper, mock)
TRANSCRIPTION_PROVIDER=mock
WHISPER_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# File Upload Settings
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
LOG_DIR=./logs

# Transcript Chunking & Processing
CHUNK_SIZE=4000
CHUNK_OVERLAP=400
MAX_TRANSCRIPT_LENGTH=50000

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

