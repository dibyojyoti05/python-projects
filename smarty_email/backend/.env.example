# MAILMIND Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://mailmind_user:mailmind_password@localhost:5432/mailmind_db
SYNC_DATABASE_URL=postgresql://mailmind_user:mailmind_password@localhost:5432/mailmind_db

# Security
# Run `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_urlsafe(32))"` to generate a secure key
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Celery & Redis
REDIS_URL=redis://localhost:6379/0

# App Settings
APP_ENV=development
FRONTEND_URL=http://localhost:3000
